# DoorDoctor backend configuration (copy to .env and adjust)
DATABASE_URL=sqlite:///./doordoc.db
JWT_SECRET=change-this-in-development
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Phase 12: document intelligence (all optional) ---
# OCR_ENGINE=none marks scanned pages "needs manual entry". For a local Chandra
# OCR 2 server (GGUF + its mmproj vision file), set OCR_ENGINE=chandra_local and:
#   LM Studio (Developer tab -> Start server): CHANDRA_BASE_URL=http://127.0.0.1:1234/v1
#   llama.cpp `llama-server --port 8080`:      CHANDRA_BASE_URL=http://127.0.0.1:8080/v1
# CHANDRA_MODEL must match the id the server reports at /v1/models.
OCR_ENGINE=none
CHANDRA_BASE_URL=http://127.0.0.1:8080/v1
CHANDRA_API_KEY=
CHANDRA_MODEL=chandra-ocr-2
OCR_TIMEOUT_S=120
DOCUMENTS_ENABLED=true
INTELLIGENCE_WORKER_ENABLED=true
