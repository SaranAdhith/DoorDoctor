# Root convenience copy. The backend reads backend/.env and the frontend reads frontend/.env.

# --- backend ---
DATABASE_URL=sqlite:///./doordoc.db
JWT_SECRET=change-this-in-development
JWT_EXPIRE_MINUTES=1440
# bcrypt work factor. Leave this at 12 anywhere real; the test suite sets it to
# 4 so that verifying ~180 passwords does not dominate the run.
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Where password reset links point (the frontend, not the API).
FRONTEND_BASE_URL=http://localhost:5173

# LLM (Phases 6 and 7). Empty key is the demo configuration: the plain-language
# summary and the assistant are both complete and correct without one.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
ASSISTANT_ENABLED=true

# Weekly/monthly report scheduling (Phase 6). The test suite sets this false.
REPORTS_SCHEDULER_ENABLED=true

# Where dose photos are written (Phase 10). Never served statically — the API
# streams them behind the same authorization as every other patient record.
UPLOAD_ROOT=app/uploads

# --- frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
